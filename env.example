# ============================================
# ELEVARE BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development
API_PREFIX=api
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# For AWS RDS, include ?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/elevare

# ============================================
# REDIS (For caching and queues)
# ============================================
# Format: redis://[host]:[port] or redis://[password]@[host]:[port]
REDIS_URL=redis://localhost:6379

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate strong secrets: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# RATE LIMITING (Throttler)
# ============================================
THROTTLER_TTL=60000
THROTTLER_LIMIT=100

# ============================================
# EMAIL / SMTP
# ============================================
# Transactional email goes out over SMTP. The app connects at boot and reports
# whether the host accepted the credentials; sending is a no-op with a warning
# until SMTP_HOST and SMTP_USER are set.
#
# NOTE: this needs outbound port 465 (or 587) open. Some hosts — Render, and a
# number of VPS providers — block outbound SMTP by default; there the boot check
# fails with a timeout and no mail ever leaves.
#
# SMTP_HOST must be the mail server's OWN hostname, not a vanity alias on your
# domain. mail.<yourdomain> usually resolves to the right box but is not on its
# TLS certificate, so the connection dies with:
#   Hostname/IP does not match certificate's altnames
# Find the real name in the SMTP banner (openssl s_client -connect host:465) or
# in cPanel's mail-client settings.
#   Namecheap shared hosting: <server>.web-hosting.com  (e.g. premium77)
#   Namecheap Private Email:  mail.privateemail.com
SMTP_HOST=premium77.web-hosting.com
# 465 with SMTP_SECURE=true (implicit TLS), or 587 with SMTP_SECURE=false (STARTTLS).
SMTP_PORT=465
SMTP_SECURE=true
# SMTP_USER is the FULL mailbox address; SMTP_PASSWORD is that mailbox's password.
SMTP_USER=accounts@leviateapp.com
SMTP_PASSWORD=
# Connections held open for broadcasts, and the per-second send cap. Keep these
# under whatever your mail provider allows — exceeding it gets the mailbox
# throttled or suspended.
SMTP_MAX_CONNECTIONS=3
SMTP_RATE_LIMIT=10
#
# From header shown to recipients. Most SMTP hosts reject a From that is not the
# authenticated mailbox, so leave this equal to SMTP_USER (or an alias of it).
FROM_NAME=Leviate
FROM_EMAIL=accounts@leviateapp.com
# Optional. Where replies go — set this to a mailbox that actually receives mail.
REPLY_TO_EMAIL=

# ============================================
# CLOUD STORAGE (AWS S3)
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=elevare-uploads
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# Alternative: Cloudinary
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# AI SERVICE
# ============================================
# Choose one: DeepSeek or Anthropic Claude
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional: override the OpenAI-compatible base URL
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OR
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229

# ============================================
# TASK PRICING (Naira per contributor slot)
# ============================================
# The rates themselves are LOCKED IN CODE and cannot be set here — see
# src/common/utils/task-pricing.util.ts. A stale TASK_CATEGORY_AMOUNT_* on a
# deployed host used to silently serve old prices, so the tables moved into the
# code where the tests pin them. Delete any of these vars still set on a host:
#   TASK_CATEGORY_AMOUNT_*  TASK_CONTENT_TYPE_AMOUNT_*  TASK_PRICING_JSON
#
# Locked rates — paid to the contributor IN FULL, per contribution:
#   text post 200 | image post 200 | video post 3500
#   like/share/save/repost 120 | comment 120 | follow 150
#
# payoutPool  = unitRate × contributorCount          <-- contributors get this
# totalBudget = payoutPool + PLATFORM_FEE_PERCENTAGE <-- what the creator funds

# The ONLY fee. Charged to the CREATOR at task creation, on top of the payout
# pool. Nothing is deducted from contributor earnings — a rate quoted on the
# marketplace is what the contributor actually receives.
#
# This replaced a 5% contributor-side deduction plus a separate
# PROCESSING_FEE_PERCENTAGE; delete both from any host that still sets them.
PLATFORM_FEE_PERCENTAGE=7

# ============================================
# PAYMENT GATEWAY
# ============================================
# Paystack (Nigeria/Ghana/Kenya)
# Use sk_test_ + pk_test_ together for test mode, or sk_live_ + pk_live_ for live.
# Initialize and verify must use the same mode as the Paystack dashboard where you see the charge.
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_BASE_URL=https://api.paystack.co
# Simulate successful withdrawals (wallet debited, no real Paystack payout). Use until transfers are enabled on Paystack.
PAYSTACK_MOCK_TRANSFERS=false

# ============================================
# IDENTITY VERIFICATION (Dojah — NIN/NIMC)
# ============================================
# Sandbox and live share identical paths; only the base URL and credentials differ.
#   sandbox: https://sandbox.dojah.io      live: https://api.dojah.io
# Credentials are per-app and per-environment — get them from your Dojah dashboard.
# The Authorization header is the RAW secret key (no "Bearer " prefix); the app
# strips one if you paste it anyway.
DOJAH_BASE_URL=https://sandbox.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# Skip the Dojah call entirely and simulate success. Local development only —
# name matching is bypassed, so anything that passes format validation verifies.
DOJAH_MOCK_VERIFICATION=false
# Require 2+ name parts from NIMC to match the profile. Sandbox returns a fixed
# test identity that cannot match a real profile, so set false there.
# MUST be true (or unset) in production.
DOJAH_ENFORCE_NAME_MATCH=true
# Sandbox test values: NIN 70123456789, vNIN AB012345678910YZ.

# Social verification: unique code per user at signup (users.social_verification_code).
# Users message this account with their code for manual review.
SOCIAL_VERIFICATION_CONTACT_PLATFORM=Instagram
SOCIAL_VERIFICATION_CONTACT_HANDLE=@leviateapp

# Social handle 90-day cooldown: set COOLDOWN_DISABLED=true while testing, remove for production.
PROFILE_SOCIAL_HANDLES_COOLDOWN_DISABLED=true
# PROFILE_SOCIAL_HANDLES_COOLDOWN_ENABLED=true

# Alternative: Flutterwave
# FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
# FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
# FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# Alternative: Stripe
# STRIPE_SECRET_KEY=your-stripe-secret-key
# STRIPE_PUBLIC_KEY=your-stripe-public-key
# STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# ============================================
# FEATURE FLAGS & BUSINESS LOGIC
# ============================================
REFERRAL_REWARD_AMOUNT=100
# PLATFORM_FEE_PERCENTAGE lives in the TASK PRICING section above — it was
# duplicated here at the old 5%, and a second value for the same key silently
# overrides the first.
CAMPAIGN_TERMINATION_FEE_PERCENTAGE=10
MIN_REPUTATION_FOR_AUTO_APPROVAL=75
DEFAULT_REPUTATION_SCORE=50
MAX_REPUTATION_SCORE=100
MIN_REPUTATION_SCORE=0

# ============================================
# ENCRYPTION (For sensitive data like NIN)
# ============================================
# Generate a 32-byte base64 key using one of these methods:
#   - openssl rand -base64 32
#   - npm run generate:encryption-key
# IMPORTANT: This key must be exactly 32 bytes when decoded from base64
# In development, you can leave this empty (dummy key will be used)
ENCRYPTION_KEY=
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_IV_LENGTH=16

# ============================================
# NOTIFICATIONS
# ============================================
# Set to false to disable all outbound email (logs what would have been sent).
# Any other value, or unset, means enabled.
NOTIFICATION_EMAIL_ENABLED=true
# Set to false to stop broadcasting newly published tasks to every contributor.
# Kills only that fan-out; one-to-one transactional email keeps working.
TASK_BROADCAST_EMAIL_ENABLED=true
NOTIFICATION_QUEUE_NAME=email-notification
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY=5000

# ============================================
# SWAGGER/API DOCUMENTATION
# ============================================
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
# Options: error, warn, info, debug, verbose
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/app.log

# ============================================
# SOCIAL MEDIA OAUTH (Optional)
# ============================================
# Facebook
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback

# Instagram
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# TikTok
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok/callback

# Snapchat
SNAPCHAT_CLIENT_ID=your-snapchat-client-id
SNAPCHAT_CLIENT_SECRET=your-snapchat-client-secret
SNAPCHAT_REDIRECT_URI=http://localhost:3000/api/auth/snapchat/callback

# LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# X (Twitter)
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_REDIRECT_URI=http://localhost:3000/api/auth/twitter/callback

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=5242880
# Max image upload size in bytes (default in code is 10MB if unset). Applies to POST /uploads/image.
ALLOWED_FILE_TYPES=jpg,jpeg,png,webp,pdf
UPLOAD_DESTINATION=s3
# Options: s3, cloudinary, local

# ============================================
# CLOUDINARY (POST /api/uploads/image — public; optional JWT stores under user folder)
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional folder prefix in Cloudinary (subfolders per user: {folder}/{userId}/...)
CLOUDINARY_UPLOAD_FOLDER=elevare

# ============================================
# IMAGEKIT (POST /api/uploads/file — requires JWT)
# ============================================
# Server-side uploads authenticate with HTTP Basic using the PRIVATE key as the
# username and an empty password. Keep it server-side only — it grants full
# read/write on your ImageKit media library.
# Keys: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxx
# Public key and URL endpoint are only needed by clients that upload directly
# from the browser (not used by this endpoint).
# IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxx
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Root folder in ImageKit; files land in {folder}/{userId}/...
IMAGEKIT_UPLOAD_FOLDER=elevare
# Max bytes for POST /uploads/file (default 25MB). Multer hard-caps at 50MB.
MAX_UPLOAD_FILE_SIZE=26214400

# ============================================
# TASK VERIFICATION
# ============================================
AI_VERIFICATION_THRESHOLD=80
# Minimum score (0-100) for task submission verification
VERIFICATION_JOB_INTERVAL=1800000
# 30 minutes in milliseconds
OCR_SERVICE=openai
# Options: openai, google-vision, tesseract

# ============================================
# WALLET & LEDGER
# ============================================
MIN_WITHDRAWAL_AMOUNT=100
MAX_WITHDRAWAL_AMOUNT=1000000
DAILY_WITHDRAWAL_LIMIT=500000
WITHDRAWAL_FEE=0
LEDGER_INTEGRITY_CHECK_ENABLED=true
LEDGER_INTEGRITY_CHECK_SCHEDULE=0 2 * * *
# Cron: Daily at 2 AM

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-in-production
# Comma-separated allowed origins (also merges FRONTEND_URL and APP_URL automatically)
# Include the API host so Swagger on backend.* can call the API (e.g. https://backend.leviateapp.com)
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ============================================
# MONITORING & HEALTH CHECKS
# ============================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=health

# ============================================
# SUPER ADMIN SEEDING
# ============================================
# Credentials for the first super admin (created by seed script)
# If not set, defaults will be used: superadmin@leviateapp.com / SuperAdmin123!
SUPERADMIN_EMAIL=superadmin@leviateapp.com
SUPERADMIN_PASSWORD=SuperAdmin123!

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Set to true to show detailed error stack traces
SHOW_ERROR_STACK=true
# Set to true to enable Prisma query logging
PRISMA_LOG_QUERIES=false
